# ==============================================================================
# 多平台用户反馈采集系统 — 环境变量模板
#
# 使用方法：
#   cp .env.example .env
#   然后把下面所有占位符替换成你自己的真实配置
#
# 安全提醒：.env 已在 .gitignore 中，绝不要提交到 Git。
# ==============================================================================

# ------------------------------------------------------------------------------
# 数据库
# ------------------------------------------------------------------------------
# 相对路径（三个斜杠）或绝对路径（四个斜杠）均可
DATABASE_URL=sqlite:///data/feedbacks.db

# ------------------------------------------------------------------------------
# LLM（OpenAI 兼容接口）
# ------------------------------------------------------------------------------
# 必填，否则 `main.py analyze` 会明确报错而不是退回规则引擎。
# 想在没有 Key 的情况下跑通链路，请显式使用：main.py analyze --allow-heuristic
OPENAI_API_KEY=sk-your-api-key-here
# DeepSeek:  https://api.deepseek.com/v1   模型 deepseek-chat
# OpenAI:    https://api.openai.com/v1     模型 gpt-4o-mini
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# Discord 采集（可选平台）
# ------------------------------------------------------------------------------
# 留空则 Discord 采集器会明确报错并跳过，不影响小红书采集。
# 需要：Discord 开发者后台创建 Bot → 邀请进你的服务器 → 填入 Token 与频道 ID
DISCORD_BOT_TOKEN=
DISCORD_TARGET_GUILD_IDS=
DISCORD_TARGET_CHANNEL_IDS=
DISCORD_KEYWORDS=bug,crash,feedback,feature request,建议,报错

# ------------------------------------------------------------------------------
# 小红书采集（真实数据源）
# ------------------------------------------------------------------------------
# 逗号分隔的搜索关键词
XHS_SEARCH_KEYWORDS=AI工具,数据科学,用户体验反馈,效率软件吐槽,软件bug反馈,笔记软件推荐,数据可视化工具,办公软件
# 采集时是否无头运行。首次 `main.py login` 会强制弹出可见窗口。
XHS_HEADLESS=true
# 默认复用本机 Google Chrome，避免下载约 150MB 的 Chromium。
# 若本机没有 Chrome：执行 `python -m playwright install chromium` 并把此项留空。
XHS_BROWSER_CHANNEL=chrome
# 登录态存储位置（已 gitignore，内含 Cookie，切勿提交）
XHS_STORAGE_STATE_PATH=data/xhs_auth_state.json
# 每个关键词单次最多采集多少条
XHS_MAX_NOTES_PER_RUN=100
# 每个关键词最多向下翻页次数
XHS_MAX_SCROLLS=6
# 连续遇到多少条已采集内容后停止翻页（增量收敛阈值）
XHS_STOP_AFTER_SEEN=40
# 等待扫码登录的超时秒数
XHS_LOGIN_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 限流与重试
# ------------------------------------------------------------------------------
# 每次请求/翻页之间的随机延时区间（秒）。调低会显著提高被风控的概率。
COLLECTOR_MIN_DELAY_SECONDS=2.0
COLLECTOR_MAX_DELAY_SECONDS=5.0
# 失败时的最大重试次数（指数退避，初始 2s，倍数 2）
COLLECTOR_MAX_RETRIES=3
