# ==============================================================================
# Multi-Platform Feedback Pipeline Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file into Git repository!
# ==============================================================================

# Database
DATABASE_URL=sqlite:///data/feedbacks.db

# LLM Configuration (OpenAI Compatible)
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Discord Collector Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_TARGET_GUILD_IDS=123456789012345678
DISCORD_TARGET_CHANNEL_IDS=123456789012345678,987654321098765432
DISCORD_KEYWORDS=bug,crash,feedback,feature request,error,suggestion

# Xiaohongshu (XHS) Playwright Collector Configuration
XHS_SEARCH_KEYWORDS=数据科学,AI工具,用户体验反馈
XHS_HEADLESS=true
XHS_STORAGE_STATE_PATH=data/xhs_auth_state.json
XHS_MAX_NOTES_PER_RUN=50

# Collector Scheduling & Rate Limits
COLLECTOR_MIN_DELAY_SECONDS=2.0
COLLECTOR_MAX_DELAY_SECONDS=5.0
COLLECTOR_MAX_RETRIES=3
